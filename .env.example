# Google Gemini via its OpenAI-compatible endpoint. Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Workhorse model for all components; free tier: 15 RPM / 500 RPD
LLM_MODEL=gemini-3.5-flash-lite
# Independent judge for evaluation samples only; free tier: 5 RPM / 20 RPD
LLM_MODEL_JUDGE=gemini-3.8-flash
# Client-side limits (sliding 60 s window + daily budget), kept BELOW provider limits
LLM_RPM=12
LLM_RPD=450
LLM_JUDGE_RPM=4
LLM_JUDGE_RPD=18
